{
  "name": "blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "generate:index": "node scripts/generate-index.mjs && node scripts/generate-search-index.mjs",
    "validate": "npm run generate:index && node scripts/validate-posts.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tanstack/react-virtual": "^3.0.0",
    "dompurify": "^3.4.12",
    "front-matter": "^4.0.2",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.0",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "happy-dom": "^20.11.1",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
