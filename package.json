{
  "name": "blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run generate:index && ASTRO_TELEMETRY_DISABLED=1 astro build && tsx scripts/generate-sitemap.ts && tsx scripts/generate-rss.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "security:audit": "npm audit --audit-level=high",
    "quality:architecture": "npm run quality:architecture:astro && npm run quality:architecture:deps",
    "quality:architecture:astro": "tsx scripts/validate-architecture.ts",
    "quality:architecture:deps": "depcruise --config .dependency-cruiser.cjs src scripts --output-type err",
    "quality:unused": "knip --no-config-hints",
    "generate:index": "tsx scripts/generate-index.ts && tsx scripts/generate-search-index.ts",
    "post:publish": "tsx scripts/publish-obsidian-post.ts",
    "validate": "npm run generate:index && tsx scripts/validate-posts.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@heroicons/react": "^2.2.0",
    "@sentry/browser": "^10.70.0",
    "astro": "^7.2.1",
    "front-matter": "^4.0.2",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "marked": "^18.0.9",
    "marked-katex-extension": "^5.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
