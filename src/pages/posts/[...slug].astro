---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comments from "../../features/posts/Comments";
import type { GetStaticPaths } from "astro";
import type { RuntimePost } from "../../core/contracts";
import { getTagColor } from "../../features/tags/tagColors";
import { formatDate } from "../../features/posts/date";
import { getAllPosts, readPostBody } from "../../lib/posts";
import { renderMarkdown } from "../../lib/markdown";
import { homePath, postPath } from "../../core/navigation/siteUrl";

export const getStaticPaths: GetStaticPaths = () =>
  getAllPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));

const { post } = Astro.props as { post: RuntimePost };
const content = renderMarkdown(readPostBody(post), post.modulePath);
const allPosts = getAllPosts();
const currentIndex = allPosts.findIndex((item) => item.slug === post.slug);
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex >= 0 && currentIndex < allPosts.length - 1
    ? allPosts[currentIndex + 1]
    : null;
---

<BaseLayout title={`${post.title} — yxshan's Blog`} description={post.excerpt}>
  <div class="mx-auto max-w-6xl px-4 py-8 lg:flex lg:gap-8">
    <article class="min-w-0 flex-1">
      <header class="article-intro theme-surface rounded-2xl border border-gray-200 bg-gray-50/80 px-6 py-6 shadow-sm dark:border-gray-700 dark:bg-gray-900/70">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-400">
          文章信息
        </p>
        <h1 class="article-title mt-3 font-bold text-gray-900 dark:text-gray-100">
          {post.title}
        </h1>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
          {post.date && (
            <span class="inline-flex items-center gap-1.5">
              <span class="font-medium text-gray-700 dark:text-gray-300">发布日期</span>
              <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
            </span>
          )}
        </div>
        {post.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {post.tags.map((tag) => {
              const color = getTagColor(tag);
              return (
                <a
                  href={homePath(`tag=${encodeURIComponent(tag)}`)}
                  class={`article-meta-tag rounded-full px-3 py-1 text-xs font-medium ${color.bg} ${color.text}`}
                >
                  {tag}
                </a>
              );
            })}
          </div>
        )}
      </header>

      <section class="mt-10">
        <div class="mb-5 flex items-center gap-3 text-sm font-semibold text-gray-500 dark:text-gray-400">
          <span class="h-px flex-1 bg-gray-200 dark:bg-gray-700" />
          <span>正文</span>
          <span class="h-px flex-1 bg-gray-200 dark:bg-gray-700" />
        </div>
        <div
          class="article-prose prose prose-gray dark:prose-invert prose-headings:scroll-mt-20 prose-a:text-blue-600 dark:prose-a:text-blue-400"
          set:html={content}
        />
      </section>

      <footer class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700">
        <nav aria-label="文章翻页" class="grid gap-3 sm:grid-cols-2">
          {prevPost ? (
            <a
              href={postPath(prevPost.slug)}
              aria-label={`上一篇：${prevPost.title}`}
              class="article-nav-card theme-surface group rounded-xl border border-gray-200 bg-white p-4 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400"
            >
              <span class="article-nav-direction block text-xs font-medium text-gray-400 dark:text-gray-500">
                <span aria-hidden="true">←</span> 上一篇
              </span>
              <span class="mt-1 block font-medium text-gray-700 group-hover:text-indigo-600 dark:text-gray-300 dark:group-hover:text-indigo-300">
                {prevPost.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {nextPost ? (
            <a
              href={postPath(nextPost.slug)}
              aria-label={`下一篇：${nextPost.title}`}
              class="article-nav-card theme-surface group rounded-xl border border-gray-200 bg-white p-4 text-right text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 sm:col-start-2"
            >
              <span class="article-nav-direction block text-xs font-medium text-gray-400 dark:text-gray-500">
                下一篇 <span aria-hidden="true">→</span>
              </span>
              <span class="mt-1 block font-medium text-gray-700 group-hover:text-indigo-600 dark:text-gray-300 dark:group-hover:text-indigo-300">
                {nextPost.title}
              </span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      </footer>

      <Comments client:visible slug={post.slug} />
    </article>

    <aside class="hidden w-64 flex-shrink-0 lg:block">
      <div class="toc-shell sticky top-24 max-h-[calc(100vh-6rem)] overflow-y-auto py-1">
        <nav id="toc" aria-label="文章目录" />
      </div>
    </aside>
  </div>

  <script>
    import { enhancePost } from "../../scripts/post-enhancements";
    import { initToc } from "../../scripts/toc";
    enhancePost();
    initToc();
  </script>
</BaseLayout>
