---
import { getAllPosts } from "../core/content/catalog";
import { homePath } from "../core/navigation/siteUrl";

const posts = getAllPosts();

const categoryMap = new Map();
for (const post of posts) {
  if (!categoryMap.has(post.category)) {
    categoryMap.set(post.category, { name: post.category, count: 0 });
  }
  categoryMap.get(post.category).count += 1;
}
const categories = [...categoryMap.values()];

const tagMap = new Map();
for (const post of posts) {
  for (const tag of post.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}
const tags = [...tagMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([name]) => name);
---

<header class="sticky top-0 z-50 w-full border-b border-gray-200 bg-white/80 backdrop-blur-md dark:border-gray-700 dark:bg-gray-900/80">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a
      href={homePath()}
      class="text-xl font-bold text-gray-900 no-underline hover:text-gray-700 dark:text-white dark:hover:text-gray-300"
    >
      yxshan&apos;s Blog
    </a>

    <div class="flex items-center gap-2">
      <a
        href={homePath("focus=1")}
        class="rounded-lg p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
        aria-label="搜索"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"
          />
        </svg>
      </a>

      <button
        type="button"
        data-theme-toggle
        class="rounded-lg p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
        aria-label="切换到暗色模式"
      >
        <svg
          data-theme-icon="light"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="4" />
          <path
            stroke-linecap="round"
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          />
        </svg>
        <svg
          data-theme-icon="dark"
          class="hidden h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"
          />
        </svg>
      </button>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="rounded-lg p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white md:hidden"
        aria-label="打开菜单"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  data-mobile-menu
  class="fixed inset-0 z-50 hidden md:hidden"
>
  <button
    type="button"
    data-menu-close
    aria-label="关闭菜单"
    class="absolute inset-0 h-full w-full bg-black/40"
  />
  <nav class="absolute right-0 top-0 h-full w-80 overflow-y-auto border-l border-gray-200 bg-white p-5 shadow-2xl dark:border-gray-800 dark:bg-gray-900">
    <div class="mb-6 flex items-center justify-between">
      <span class="text-lg font-bold">导航</span>
      <button
        type="button"
        data-menu-close
        class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800"
        aria-label="关闭菜单"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            d="M6 6l12 12M18 6L6 18"
          />
        </svg>
      </button>
    </div>

    <a
      href={homePath()}
      class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800"
    >
      首页
    </a>
    <a
      href={homePath("focus=1")}
      class="block rounded-lg px-3 py-2 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800"
    >
      搜索
    </a>

    <h3 class="mt-6 mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-gray-400">
      分类
    </h3>
    <div class="space-y-1">
      {categories.map((category) => (
        <a
          href={homePath(`category=${encodeURIComponent(category.name)}`)}
          class="flex items-center justify-between rounded-lg px-3 py-2 text-sm hover:bg-gray-100 dark:hover:bg-gray-800"
        >
          <span>{category.name}</span>
          <span class="text-xs text-gray-400">{category.count}</span>
        </a>
      ))}
    </div>

    <h3 class="mt-6 mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-gray-400">
      热门标签
    </h3>
    <div class="flex flex-wrap gap-2 px-3">
      {tags.map((tag) => (
        <a
          href={homePath(`tag=${encodeURIComponent(tag)}`)}
          class="rounded-full border border-gray-200 px-3 py-1 text-xs hover:bg-gray-100 dark:border-gray-700 dark:hover:bg-gray-800"
        >
          {tag}
        </a>
      ))}
    </div>
  </nav>
</div>

<script>
  const menu = document.querySelector("[data-mobile-menu]");
  const openButtons = document.querySelectorAll("[data-menu-toggle]");
  const closeButtons = document.querySelectorAll("[data-menu-close]");

  function setMenu(open) {
    if (!menu) return;
    menu.classList.toggle("hidden", !open);
    openButtons.forEach((button) =>
      button.setAttribute("aria-expanded", String(open)),
    );
  }

  openButtons.forEach((button) =>
    button.addEventListener("click", () => setMenu(true)),
  );
  closeButtons.forEach((button) =>
    button.addEventListener("click", () => setMenu(false)),
  );
  menu?.querySelectorAll("a").forEach((link) =>
    link.addEventListener("click", () => setMenu(false)),
  );
</script>
